# Python venv (dev only)
venv/
.venv311/

# ── Runtime payload (generated by scripts/build_runtime.bat) ──────────────
# These are binary/large assets that must NOT be committed.
# Maintainers generate them locally via scripts/build_runtime.bat.
runtime/python/
runtime/cyclonedds/
runtime/wheels/*.whl
runtime/wheels/*.tar.gz
runtime/wheels/*.zip
runtime/_downloads/

# Runtime state files (machine-local, written at install/run time)
runtime/env/install_state.json
runtime/env/bootstrap_state.json

# Distribution output
dist_package/
*.zip

# Byte-compiled / cache
__pycache__/
__cache__
*.claude
*.py[cod]
*.pyo

# Build / packaging
build/
dist/
*.egg-info/

# Logs / runtime
logs/
*.log

# Temp / editor
*.tmp
.tmp/
*.swp
*.swo
*.bak
.cache/
.pytest_cache/

# OS files
.DS_Store
desktop.ini
AGENTS.md

# Local config overrides
config/user.ini
config/*.local.ini
config/local.ini
