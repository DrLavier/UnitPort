{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unitport:behavior-motor-weight-protocol:v1",
  "title": "Behavior Motor Weight Protocol",
  "description": "Mission->Behavior structured payload for deterministic motor parameter application.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "trace_id",
    "timestamp_ms",
    "mode",
    "max_age_ms",
    "targets"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "type": "string",
      "enum": [
        "constant",
        "external"
      ]
    },
    "max_age_ms": {
      "type": "integer",
      "minimum": 1
    },
    "quality": {
      "type": "string",
      "enum": [
        "valid",
        "stale",
        "invalid"
      ],
      "default": "valid"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Target"
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motor_key",
        "param_key",
        "address",
        "dtype",
        "shape",
        "source"
      ],
      "properties": {
        "motor_key": {
          "type": "string",
          "minLength": 1
        },
        "param_key": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "description": "Stable address/index path resolved by Behavior runtime.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "dtype": {
          "type": "string",
          "enum": [
            "float32",
            "float64"
          ]
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "constant",
            "external"
          ]
        },
        "constant": {
          "$ref": "#/$defs/NumericValue"
        },
        "external_key": {
          "type": "string",
          "minLength": 1
        },
        "external_value": {
          "$ref": "#/$defs/NumericValue"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "constant"
              }
            }
          },
          "then": {
            "required": [
              "constant"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "external"
              }
            }
          },
          "then": {
            "required": [
              "external_key",
              "external_value"
            ]
          }
        }
      ]
    },
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "clamp": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "NumericValue": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        }
      ]
    }
  }
}
