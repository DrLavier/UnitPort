      "default_controller_type": "champ"
    },
    "xiaomi": {
      "id": "xiaomi",
      "display_name": "XiaoMi",
      "adapter_key": "cyberdog_sdk",
      "sdk_project_keys": ["cyberdog_ros2"],
      "sdk_project_urls": {
        "cyberdog_ros2": "https://github.com/MiRoboticsLab/cyberdog_ros2.git"
      },
      "ros2_onboarding_compatible": false,
      "default_controller_type": ""
