        "unitree_mujoco": "https://github.com/unitreerobotics/unitree_mujoco.git",
        "go2_webrtc": "https://github.com/tfoldi/go2-webrtc.git"
      },
      "sdk_project_install_subdir": {
        "go2_webrtc": "python"
      },
