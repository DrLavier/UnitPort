    {
      "id": "stand",
      "display_name": "Stand",
      "default_motion_tag": "stand",
      "command_template": {
        "lin_vel_x": [0.0, 0.0],
        "lin_vel_y": [0.0, 0.0],
        "ang_vel_z": [0.0, 0.0]
      },
      "speed_channel": "lin_vel_x",
      "zero_channels": ["lin_vel_x", "lin_vel_y", "ang_vel_z"],
      "gait_hint": null,
      "description": "Stationary stance — all velocity channels forced to zero.",
      "builtin": true
    },
    {
      "id": "walk",
      "display_name": "Walk",
      "default_motion_tag": "walk",
      "command_template": {
        "lin_vel_x": [0.0, 1.0],
