{
  "schema_id": "builtin.retry",
  "display_name": "Retry",
  "node_type": "retry",
  "kind": "retry",
  "ports": [
    {"name": "flow_in",     "direction": "input",  "data_type": "void", "required": true},
    {"name": "retry_body",  "direction": "output", "data_type": "void", "required": true},
    {"name": "out_success", "direction": "output", "data_type": "void"},
    {"name": "out_failed",  "direction": "output", "data_type": "void"}
  ],
  "parameters": [
    {
      "name": "max_attempts",
      "param_type": "int",
      "default": 3,
      "constraints": {"min_value": 1.0}
    },
    {
      "name": "backoff_sec",
      "param_type": "float",
      "default": 1.0,
      "unit": "seconds",
      "constraints": {"min_value": 0.0}
    },
    {
      "name": "strategy",
      "param_type": "string",
      "default": "fixed",
      "constraints": {"choices": ["fixed", "linear", "exponential"]}
    }
  ],
  "code_template": "",
  "robot_compat": [],
  "safety": {},
  "version": "1.0"
}
