{
  "schema_id": "builtin.action_execution",
  "display_name": "Action Execution",
  "node_type": "action_execution",
  "kind": "action",
  "ports": [
    {"name": "flow_in",  "direction": "input",  "data_type": "void", "required": true},
    {"name": "flow_out", "direction": "output", "data_type": "void", "required": true}
  ],
  "parameters": [
    {
      "name": "action",
      "param_type": "string",
      "default": "stand",
      "description": "Robot action identifier. Choices are synced dynamically from the IR action registry."
    }
  ],
  "code_template": "robot.run_action(\"{action}\")",
  "robot_compat": [],
  "safety": {},
  "version": "1.0"
}
