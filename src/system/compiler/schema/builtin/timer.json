{
  "schema_id": "builtin.timer",
  "display_name": "Timer",
  "node_type": "timer",
  "kind": "timer",
  "ports": [
    {"name": "flow_in",  "direction": "input",  "data_type": "void", "required": true},
    {"name": "flow_out", "direction": "output", "data_type": "void", "required": true}
  ],
  "parameters": [
    {
      "name": "duration",
      "param_type": "float",
      "default": 1.0,
      "unit": "seconds",
      "constraints": {"min_value": 0.0}
    },
    {
      "name": "unit",
      "param_type": "string",
      "default": "seconds",
      "constraints": {"choices": ["seconds", "milliseconds", "minutes"]}
    }
  ],
  "code_template": "time.sleep({duration})",
  "robot_compat": [],
  "safety": {},
  "version": "1.0"
}
