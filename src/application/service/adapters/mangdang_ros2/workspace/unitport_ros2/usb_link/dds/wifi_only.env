# UnitPort DDS profile — let DDS auto-pick wlan0 (factory default behavior).
# No FASTRTPS_DEFAULT_PROFILES_FILE / CYCLONEDDS_URI override so the RMW
# uses its built-in defaults, identical to the stock MangDang flow.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
