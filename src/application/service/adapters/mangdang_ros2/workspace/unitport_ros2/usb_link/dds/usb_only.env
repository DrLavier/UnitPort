# UnitPort DDS profile — bind traffic strictly to usb0 (192.168.55.1).
# Sourced via EnvironmentFile= in unitport-bridge.service when
# /etc/unitport/dds/active.env symlinks here.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTRTPS_DEFAULT_PROFILES_FILE=/etc/unitport/dds/fastdds_usb_only.xml
CYCLONEDDS_URI=file:///etc/unitport/dds/cyclonedds_usb_only.xml
