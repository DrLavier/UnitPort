<?xml version="1.0"?>
<package format="3">
  <name>unitport_state_pub</name>
  <version>0.1.0</version>
  <description>UnitPort unified robot state publisher on /unitport/robot_state.</description>
  <maintainer email="noreply@unitport.dev">UnitPort</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>unitport_msgs</depend>

  <export><build_type>ament_python</build_type></export>
</package>
