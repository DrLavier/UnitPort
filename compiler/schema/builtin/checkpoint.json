{
  "schema_id": "checkpoint",
  "display_name": "Checkpoint",
  "node_type": "checkpoint",
  "kind": "custom",
  "ports": [
    {
      "name": "checkpoint",
      "direction": "output",
      "data_type": "dict",
      "description": "Resolved checkpoint handle for downstream behavior nodes"
    }
  ],
  "parameters": [
    {
      "name": "policy_id",
      "param_type": "string",
      "default": "",
      "description": "Checkpoint bundle id from CheckpointRegistry"
    },
    {
      "name": "format",
      "param_type": "string",
      "default": "auto",
      "description": "Bundle format hint resolved from manifest at runtime"
    }
  ],
  "code_template": "# checkpoint('{policy_id}', format='{format}')",
  "robot_compat": [],
  "safety": {
    "requires_robot": false
  },
  "version": "1.0"
}
