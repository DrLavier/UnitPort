{
    "schema_id": "builtin.wait",
    "display_name": "Wait",
    "node_type": "wait",
    "kind": "wait",
    "ports": [
        {"name": "flow_in", "direction": "input", "data_type": "void"},
        {"name": "flow_out", "direction": "output", "data_type": "void"}
    ],
    "parameters": [
        {
            "name": "mode",
            "param_type": "string",
            "default": "duration",
            "constraints": {"choices": ["duration", "event"]},
            "description": "Wait mode: duration or event"
        },
        {
            "name": "duration",
            "param_type": "float",
            "default": 1.0,
            "constraints": {"min_value": 0.0, "max_value": 60.0},
            "unit": "seconds",
            "description": "Wait duration (duration mode)"
        },
        {
            "name": "event_name",
            "param_type": "string",
            "default": "",
            "description": "Event to wait for (event mode)"
        },
        {
            "name": "timeout",
            "param_type": "float",
            "default": 0.0,
            "constraints": {"min_value": 0.0},
            "unit": "seconds",
            "description": "Timeout for event wait (0 = no timeout)"
        }
    ],
    "code_template": "time.sleep({duration})",
    "robot_compat": [],
    "version": "1.0"
}
