{
  "schema_id": "behavior",
  "display_name": "Behavior",
  "node_type": "behavior",
  "kind": "custom",
  "ports": [
    {
      "name": "flow_in",
      "direction": "input",
      "data_type": "void"
    },
    {
      "name": "checkpoint",
      "direction": "input",
      "data_type": "dict",
      "description": "Optional checkpoint handle from an upstream Checkpoint node"
    },
    {
      "name": "flow_out",
      "direction": "output",
      "data_type": "void"
    }
  ],
  "parameters": [
    {
      "name": "policy_id",
      "param_type": "string",
      "default": "",
      "description": "Fallback checkpoint id when no checkpoint input is wired"
    },
    {
      "name": "command_vx",
      "param_type": "float",
      "default": 0.0,
      "description": "Forward command velocity in m/s"
    },
    {
      "name": "command_vy",
      "param_type": "float",
      "default": 0.0,
      "description": "Lateral command velocity in m/s"
    },
    {
      "name": "command_wz",
      "param_type": "float",
      "default": 0.0,
      "description": "Yaw rate command in rad/s"
    },
    {
      "name": "duration_sec",
      "param_type": "float",
      "default": 3.0,
      "description": "Execution duration in seconds"
    }
  ],
  "code_template": "# behavior(policy_id='{policy_id}', vx={command_vx}, vy={command_vy}, wz={command_wz}, duration={duration_sec})",
  "robot_compat": [],
  "safety": {
    "requires_robot": false
  },
  "version": "1.0"
}
