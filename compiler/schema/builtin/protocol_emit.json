{
  "schema_id": "builtin.protocol_emit",
  "display_name": "Protocol Emit",
  "node_type": "protocol_emit",
  "kind": "protocol_emit",
  "ports": [
    {"name": "flow_in",          "direction": "input",  "data_type": "void"},
    {"name": "sensor_data",      "direction": "input",  "data_type": "any"},
    {"name": "flow_out",         "direction": "output", "data_type": "void"},
    {"name": "protocol_payload", "direction": "output", "data_type": "any"},
    {"name": "condition",        "direction": "output", "data_type": "any"}
  ],
  "parameters": [
    {"name": "motor_key",    "param_type": "string", "default": "FL_hip",           "description": "Motor key"},
    {"name": "param_key",    "param_type": "string", "default": "stiffness",        "description": "Parameter key"},
    {"name": "address",      "param_type": "string", "default": "FL_hip.stiffness", "description": "Route key/address"},
    {"name": "dtype",        "param_type": "string", "default": "float",            "description": "Value data type hint"},
    {"name": "max_age_ms",   "param_type": "int",    "default": 1000,               "description": "Payload freshness window in ms"},
    {"name": "signal",       "param_type": "string", "default": "",                 "description": "Signal convention name"},
    {"name": "sensor_field", "param_type": "string", "default": "x",                "description": "Sensor field to read"}
  ],
  "code_template": "# Protocol Emit\nprotocol_payload = ProtocolPayloadCompiler.from_sensor_imu(sensor_data=sensor_data, motor_key=\"{motor_key}\", param_key=\"{param_key}\", sensor_field=\"{sensor_field}\", address=\"{address}\", max_age_ms={max_age_ms})\n",
  "robot_compat": ["go2", "spot", "cyberdog"],
  "safety": {
    "requires_robot": false
  },
  "version": "1.0"
}
