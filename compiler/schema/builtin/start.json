        {
            "name": "robot_type",
            "param_type": "string",
            "default": "go2",
            "description": "Robot type to use for the workflow"
        }
    ],
    "code_template": "RobotContext.set_robot_type('{robot_type}')",
    "robot_compat": [],
    "version": "1.0"
}
