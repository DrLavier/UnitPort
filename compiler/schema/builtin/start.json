{
    "schema_id": "builtin.start",
    "display_name": "Start",
    "node_type": "start",
    "kind": "start",
    "ports": [
        {"name": "flow_out", "direction": "output", "data_type": "void"}
    ],
    "parameters": [
        {
            "name": "robot_brand",
